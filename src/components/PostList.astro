---
import type { Post } from '../lib/site';
import PostCard from './PostCard.astro';
interface Props { posts: Post[]; empty?: string; headingLevel?: 'h2' | 'h3' }
const { posts, empty = 'Ainda não há publicações aqui. Em breve, novos conteúdos.', headingLevel } = Astro.props;
---
{posts.length > 0 ? (
  <ul class="post-list">
    {posts.map((p) => <li><PostCard post={p} headingLevel={headingLevel} /></li>)}
  </ul>
) : (
  <p class="empty">{empty}</p>
)}
