---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import CtaPlano from '../../components/CtaPlano.astro';
import { getPosts, slugify, type Post } from '../../lib/site';

export async function getStaticPaths() {
  const posts = await getPosts();
  const map = new Map<string, { nome: string; posts: Post[] }>();
  for (const p of posts) {
    for (const t of p.data.tags) {
      const slug = slugify(t);
      if (!map.has(slug)) map.set(slug, { nome: t, posts: [] });
      map.get(slug)!.posts.push(p);
    }
  }
  return [...map].map(([tag, v]) => ({ params: { tag }, props: v }));
}
const { nome, posts } = Astro.props as { nome: string; posts: Post[] };
---
<BaseLayout title={`#${nome}`} description={`Publicações com a tag ${nome}.`}>
  <div class="container">
    <header class="page">
      <p class="eyebrow">Tag</p>
      <h1>#{nome}</h1>
    </header>
    <PostList posts={posts} headingLevel="h2" />
    <CtaPlano />
  </div>
</BaseLayout>
