---
/**
 * /plano — página interativa do plano grátis "Comece pelo Novo Testamento".
 * Os textos ficam em src/data/plano.ts. O progresso fica só no aparelho
 * (localStorage), sem login nem backend.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PlanoEbook from '../components/plano/PlanoEbook.astro';
import {
  PLANO_CAPA as capa,
  PLANO_PROGRESSO as prog,
  PLANO_COMO_USAR,
  PLANO_POR_QUE,
  PLANO_DIAS as dias,
  PLANO_STORAGE_KEY,
} from '../data/plano';

const total = dias.length;
const RAIO = 26;
const CIRC = +(2 * Math.PI * RAIO).toFixed(2);

const config = {
  key: PLANO_STORAGE_KEY,
  total,
  textos: prog,
};
---
<BaseLayout
  title="Comece pelo Novo Testamento — plano grátis de 7 dias"
  description="Plano grátis de 7 leituras do Novo Testamento, de Marcos a Filipenses, com contexto, ideia-chave, perguntas e aplicação. Seu progresso fica salvo no aparelho."
>
  <div class="container plano" id="plano" data-config={JSON.stringify(config)}>
    <!-- HOME DO PLANO -->
    <section class="plano-view" data-view="home" aria-labelledby="plano-titulo">
      <header class="plano-capa">
        <p class="eyebrow">{capa.kicker}</p>
        <h1 id="plano-titulo" tabindex="-1">
          {capa.tituloAntes} <em class="plano-destaque">{capa.tituloDestaque}</em>
        </h1>
        <p class="plano-lead">{capa.lead}</p>
        <ul class="plano-chips" aria-label="Sobre o plano">
          {capa.chips.map((c) => <li>{c}</li>)}
        </ul>
      </header>

      <div class="plano-progresso" aria-live="polite">
        <div class="plano-anel" aria-hidden="true">
          <svg viewBox="0 0 64 64" width="64" height="64">
            <circle class="anel-fundo" cx="32" cy="32" r={RAIO} />
            <circle
              class="anel-valor"
              cx="32" cy="32" r={RAIO}
              stroke-dasharray={CIRC}
              stroke-dashoffset={CIRC}
              data-circ={CIRC}
              transform="rotate(-90 32 32)"
            />
          </svg>
          <span class="anel-texto" data-contador>0/{total}</span>
        </div>
        <div>
          <p class="plano-progresso-titulo" data-prog-titulo>{prog.inicioTitulo}</p>
          <p class="plano-progresso-texto" data-prog-texto>{prog.inicioTexto}</p>
          <p class="sr-only" data-prog-sr>0 de {total} leituras concluídas.</p>
        </div>
      </div>

      <a class="plano-btn" href="#dia-1" data-btn-principal>{prog.botaoInicio}</a>

      <div data-ebook hidden>
        <PlanoEbook id="ebook-home" />
      </div>

      <h2 class="plano-h2">As {total} leituras</h2>
      <ol class="plano-lista">
        {dias.map((d) => (
          <li>
            <a class="plano-item" href={`#dia-${d.numero}`} data-item={d.numero}>
              <span class="plano-num" aria-hidden="true">
                <span class="num-n">{d.numero}</span>
                <svg class="num-check" viewBox="0 0 24 24" width="20" height="20"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
              </span>
              <span class="plano-item-txt">
                <span class="plano-item-titulo">
                  <span class="sr-only">Dia {d.numero}: </span>{d.titulo}
                </span>
                <span class="plano-item-ref">{d.passagem}</span>
                <span class="sr-only" data-item-sr></span>
              </span>
              <svg class="plano-chevron" aria-hidden="true" viewBox="0 0 24 24" width="20" height="20"><path d="M9 6l6 6-6 6" /></svg>
            </a>
          </li>
        ))}
      </ol>

      <details class="plano-extra">
        <summary>Como usar</summary>
        <ol>
          {PLANO_COMO_USAR.map((p) => <li>{p}</li>)}
        </ol>
      </details>
      <details class="plano-extra">
        <summary>Por que começar pelos Evangelhos?</summary>
        {PLANO_POR_QUE.map((p) => <p>{p}</p>)}
      </details>
    </section>

    <!-- DIAS -->
    {dias.map((d, i) => (
      <article class="plano-view plano-dia" data-view={`dia-${d.numero}`} id={`dia-${d.numero}`} aria-labelledby={`dia-${d.numero}-titulo`}>
        <a class="plano-voltar" href="#inicio" data-voltar>
          <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18"><path d="M15 6l-6 6 6 6" /></svg>
          Voltar à lista
        </a>
        <p class="eyebrow">Dia {d.numero} · {capa.duracao}</p>
        <h2 class="plano-dia-titulo" id={`dia-${d.numero}-titulo`} tabindex="-1">{d.titulo}</h2>
        <p class="plano-passagem">
          <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18"><path d="M4 5.5C6.5 4 9.5 4 12 6c2.5-2 5.5-2 8-.5V19c-2.5-1.5-5.5-1.5-8 .5-2.5-2-5.5-2-8-.5z M12 6v13.5" /></svg>
          <span>Leia na sua Bíblia: <strong>{d.passagem}</strong></span>
        </p>

        <section class="plano-bloco">
          <h3>Contexto</h3>
          {d.contexto.map((p) => <p>{p}</p>)}
        </section>
        <section class="plano-bloco plano-bloco-chave">
          <h3>Ideia-chave</h3>
          <p>{d.ideiaChave}</p>
        </section>
        <section class="plano-bloco">
          <h3>Para refletir</h3>
          <ol class="plano-perguntas">
            {d.perguntas.map((q) => <li>{q}</li>)}
          </ol>
        </section>
        <section class="plano-bloco">
          <h3>Aplicação de hoje</h3>
          <p>{d.aplicacao}</p>
        </section>

        {d.nota && <p class="plano-nota">{d.nota}</p>}

        <label class="plano-check">
          <input type="checkbox" data-check={d.numero} />
          <span class="plano-check-box" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="18" height="18"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
          </span>
          <span>{capa.checkbox}</span>
        </label>

        <div class="plano-notas">
          <label for={`notas-${d.numero}`}>Minhas anotações <span class="opcional">(opcional, ficam só neste aparelho)</span></label>
          <textarea id={`notas-${d.numero}`} rows="4" data-notas={d.numero}></textarea>
        </div>

        {d.numero === total && (
          <div data-ebook hidden>
            <PlanoEbook id="ebook-dia" />
          </div>
        )}

        <nav class="plano-nav" aria-label="Navegação entre os dias">
          {i > 0 ? (
            <a href={`#dia-${d.numero - 1}`} class="plano-nav-ant">
              <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18"><path d="M15 6l-6 6 6 6" /></svg>
              Dia {d.numero - 1}
            </a>
          ) : <span />}
          {i < total - 1 ? (
            <a href={`#dia-${d.numero + 1}`} class="plano-nav-prox">
              Dia {d.numero + 1}
              <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18"><path d="M9 6l6 6-6 6" /></svg>
            </a>
          ) : (
            <a href="#inicio" class="plano-nav-prox" data-voltar>Ver o progresso</a>
          )}
        </nav>
      </article>
    ))}
  </div>
</BaseLayout>

<script>
  type Estado = { done: number[]; notes: Record<string, string> };

  const root = document.getElementById('plano');
  if (root) iniciar(root);

  function iniciar(root: HTMLElement) {
    const cfg = JSON.parse(root.dataset.config || '{}');
    const KEY: string = cfg.key;
    const TOTAL: number = cfg.total;
    const T = cfg.textos as Record<string, string>;

    const ler = (): Estado => {
      try {
        const raw = JSON.parse(localStorage.getItem(KEY) || 'null');
        const done = Array.isArray(raw?.done)
          ? raw.done.filter((n: unknown) => Number.isInteger(n) && (n as number) >= 1 && (n as number) <= TOTAL)
          : [];
        const notes = raw && typeof raw.notes === 'object' && raw.notes ? raw.notes : {};
        return { done: [...new Set<number>(done)].sort((a, b) => a - b), notes };
      } catch {
        return { done: [], notes: {} };
      }
    };
    let estado = ler();
    const salvar = () => {
      try { localStorage.setItem(KEY, JSON.stringify(estado)); } catch { /* armazenamento indisponível */ }
    };

    root.classList.add('js');
    const views = Array.from(root.querySelectorAll<HTMLElement>('.plano-view'));

    function render() {
      const feitos = new Set(estado.done);
      const n = feitos.size;
      const completo = n === TOTAL;

      root.querySelector('[data-contador]')!.textContent = `${n}/${TOTAL}`;
      const anel = root.querySelector<SVGCircleElement>('.anel-valor')!;
      const circ = Number(anel.dataset.circ);
      anel.style.strokeDashoffset = String(circ * (1 - n / TOTAL));
      root.querySelector('.plano-anel')!.classList.toggle('completo', completo);

      const titulo = root.querySelector('[data-prog-titulo]')!;
      const texto = root.querySelector('[data-prog-texto]')!;
      if (n === 0) { titulo.textContent = T.inicioTitulo; texto.textContent = T.inicioTexto; }
      else if (completo) { titulo.textContent = T.fimTitulo; texto.textContent = T.fimTexto; }
      else { titulo.textContent = T.andamentoTitulo.replace('{n}', String(n)); texto.textContent = T.andamentoTexto; }
      root.querySelector('[data-prog-sr]')!.textContent = `${n} de ${TOTAL} leituras concluídas.`;

      let proximo = 1;
      for (let d = 1; d <= TOTAL; d++) if (!feitos.has(d)) { proximo = d; break; }
      const btn = root.querySelector<HTMLAnchorElement>('[data-btn-principal]')!;
      if (n === 0) { btn.textContent = T.botaoInicio; btn.href = '#dia-1'; }
      else if (completo) { btn.textContent = T.botaoFim; btn.href = '#dia-1'; }
      else { btn.textContent = T.botaoContinuar.replace('{n}', String(proximo)); btn.href = `#dia-${proximo}`; }

      root.querySelectorAll<HTMLElement>('[data-item]').forEach((a) => {
        const d = Number(a.dataset.item);
        const ok = feitos.has(d);
        a.classList.toggle('feito', ok);
        a.querySelector('[data-item-sr]')!.textContent = ok ? ' — concluído' : '';
      });
      root.querySelectorAll<HTMLInputElement>('[data-check]').forEach((c) => {
        c.checked = feitos.has(Number(c.dataset.check));
      });

      const mostrarEbook = completo || feitos.has(TOTAL);
      root.querySelectorAll<HTMLElement>('[data-ebook]').forEach((el) => { el.hidden = !mostrarEbook; });
    }

    function mostrar(foco: boolean) {
      const m = location.hash.match(/^#dia-(\d+)$/);
      const dia = m ? Number(m[1]) : 0;
      const alvo = dia >= 1 && dia <= TOTAL ? `dia-${dia}` : 'home';
      views.forEach((v) => v.classList.toggle('ativa', v.dataset.view === alvo));
      if (foco) {
        window.scrollTo({ top: 0 });
        const h = alvo === 'home'
          ? root.querySelector<HTMLElement>('#plano-titulo')
          : root.querySelector<HTMLElement>(`#${alvo}-titulo`);
        h?.focus({ preventScroll: true });
      }
    }

    root.addEventListener('change', (e) => {
      const el = e.target as HTMLInputElement;
      if (!el.matches('[data-check]')) return;
      const d = Number(el.dataset.check);
      const s = new Set(estado.done);
      if (el.checked) s.add(d); else s.delete(d);
      estado.done = [...s].sort((a, b) => a - b);
      salvar();
      render();
    });

    root.querySelectorAll<HTMLTextAreaElement>('[data-notas]').forEach((t) => {
      t.value = estado.notes[t.dataset.notas!] || '';
      t.addEventListener('input', () => {
        const k = t.dataset.notas!;
        if (t.value.trim()) estado.notes[k] = t.value; else delete estado.notes[k];
        salvar();
      });
    });

    // "Voltar à lista": limpa o hash sem deixar #inicio na URL.
    root.querySelectorAll<HTMLAnchorElement>('[data-voltar]').forEach((a) => {
      a.addEventListener('click', (e) => {
        e.preventDefault();
        history.pushState(null, '', location.pathname + location.search);
        mostrar(true);
      });
    });

    window.addEventListener('hashchange', () => mostrar(true));
    window.addEventListener('popstate', () => mostrar(true));
    window.addEventListener('storage', (e) => {
      if (e.key === KEY) { estado = ler(); render(); }
    });

    render();
    mostrar(/^#dia-\d+$/.test(location.hash));
  }
</script>

<style>
  .plano { max-width: 40rem; padding-top: 2.5rem; padding-bottom: 1rem; }

  /* Sem JS, tudo aparece em sequência; com JS, só a vista ativa. */
  .plano.js .plano-view:not(.ativa) { display: none; }
  .plano:not(.js) .plano-dia { border-top: 1px solid var(--border); margin-top: 2.5rem; padding-top: 2rem; }
  .plano:not(.js) .plano-voltar,
  .plano:not(.js) .plano-check,
  .plano:not(.js) .plano-notas { display: none; }

  .plano h1 { font-size: clamp(2rem, 7vw, 2.75rem); margin-bottom: .5rem; outline: none; }
  .plano-destaque {
    font-family: var(--font-body); font-style: italic; font-weight: 600;
    color: var(--gold);
  }
  .plano-lead { color: var(--muted); font-size: 1.15rem; line-height: 1.6; margin-bottom: 1rem; }

  .plano-chips { list-style: none; margin: 0 0 1.5rem; padding: 0; display: flex; flex-wrap: wrap; gap: .5rem; }
  .plano-chips li {
    font-family: var(--font-title); font-size: .85rem; font-weight: 500;
    color: var(--gold); background: rgba(255, 200, 61, .1);
    border: 1px solid rgba(255, 200, 61, .25);
    border-radius: 999px; padding: .3rem .8rem; line-height: 1.3;
  }

  /* Card de progresso */
  .plano-progresso {
    display: flex; align-items: center; gap: 1rem;
    background: var(--surface); border: 1px solid var(--border);
    border-radius: var(--radius); padding: 1rem 1.1rem; margin-bottom: 1rem;
  }
  .plano-progresso p { margin: 0; }
  .plano-progresso-titulo { font-family: var(--font-title); font-weight: 600; font-size: 1.05rem; line-height: 1.35; }
  .plano-progresso-texto { color: var(--muted); font-size: 1rem; line-height: 1.45; margin-top: .2rem !important; }
  .plano-anel { position: relative; flex: 0 0 64px; width: 64px; height: 64px; }
  .plano-anel svg { display: block; }
  .anel-fundo { fill: none; stroke: var(--border); stroke-width: 5; }
  .anel-valor {
    fill: none; stroke: var(--gold); stroke-width: 5; stroke-linecap: round;
    transition: stroke-dashoffset .4s ease;
  }
  .anel-texto {
    position: absolute; inset: 0; display: grid; place-items: center;
    font-family: var(--font-title); font-weight: 700; font-size: .95rem; color: var(--text);
  }
  .plano-anel.completo .anel-texto { color: var(--gold); }

  .plano-btn {
    display: flex; align-items: center; justify-content: center; min-height: 3.25rem;
    width: 100%; text-align: center; text-decoration: none;
    background: var(--gold); color: var(--on-gold);
    font-family: var(--font-title); font-weight: 600; font-size: 1.05rem;
    border-radius: 12px; padding: .8rem 1.2rem;
    transition: background-color .15s ease;
  }
  .plano-btn:hover { background: #ffd76e; color: var(--on-gold); }
  .plano-btn:focus-visible { outline-color: var(--text); }

  .plano-h2 { font-size: 1.5rem; margin: 2.25rem 0 1rem; }

  /* Lista dos dias */
  .plano-lista { list-style: none; margin: 0; padding: 0; display: grid; gap: .7rem; }
  .plano-item {
    display: flex; align-items: center; gap: .9rem; min-height: 4.5rem;
    background: var(--surface); border: 1px solid var(--border);
    border-radius: var(--radius); padding: .85rem 1rem;
    color: var(--text); text-decoration: none;
    transition: border-color .15s ease;
  }
  .plano-item:hover { border-color: var(--gold-soft); color: var(--text); }
  .plano-num {
    flex: 0 0 2.6rem; width: 2.6rem; height: 2.6rem; border-radius: 50%;
    border: 2px solid var(--border); display: grid; place-items: center;
    font-family: var(--font-title); font-weight: 600; font-size: 1rem; color: var(--muted);
  }
  .num-check { display: none; fill: none; stroke: var(--on-gold); stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; }
  .plano-item.feito .plano-num { background: var(--gold); border-color: var(--gold); }
  .plano-item.feito .num-n { display: none; }
  .plano-item.feito .num-check { display: block; }
  .plano-item-txt { flex: 1; min-width: 0; display: flex; flex-direction: column; }
  .plano-item-titulo { font-family: var(--font-title); font-weight: 600; font-size: 1rem; line-height: 1.35; }
  .plano-item-ref { color: var(--muted); font-size: .95rem; line-height: 1.4; margin-top: .15rem; }
  .plano-chevron { flex: 0 0 auto; fill: none; stroke: var(--muted); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }

  /* Como usar / Por quê */
  .plano-extra {
    margin-top: 1rem; background: var(--surface); border: 1px solid var(--border);
    border-radius: var(--radius); padding: 0 1.1rem;
  }
  .plano-extra:first-of-type { margin-top: 2rem; }
  .plano-extra summary {
    cursor: pointer; padding: 1rem 0; min-height: 3rem;
    font-family: var(--font-title); font-weight: 600; font-size: 1rem;
  }
  .plano-extra ol { padding-left: 1.3em; margin: 0 0 1rem; }
  .plano-extra li { margin-bottom: .4em; font-size: 1.05rem; }
  .plano-extra p { font-size: 1.05rem; }

  /* Vista do dia */
  .plano-voltar {
    display: inline-flex; align-items: center; gap: .35rem; min-height: 2.75rem;
    font-family: var(--font-title); font-weight: 500; font-size: .95rem;
    color: var(--muted); text-decoration: none; margin-bottom: 1rem;
  }
  .plano-voltar:hover { color: var(--gold); }
  .plano-voltar svg, .plano-nav svg { fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .plano-dia-titulo { font-size: clamp(1.7rem, 6vw, 2.2rem); margin-bottom: .6rem; outline: none; }
  .plano-passagem {
    display: flex; align-items: center; gap: .55rem;
    font-family: var(--font-title); font-size: 1rem; color: var(--muted);
    background: var(--surface); border: 1px solid var(--border);
    border-radius: 10px; padding: .65rem .9rem; margin-bottom: 1.75rem;
  }
  .plano-passagem strong { color: var(--gold); font-weight: 600; }
  .plano-passagem svg { flex: 0 0 auto; fill: none; stroke: var(--gold); stroke-width: 1.6; stroke-linejoin: round; }

  .plano-bloco { margin-bottom: 1.6rem; }
  .plano-bloco h3 {
    font-size: .8rem; text-transform: uppercase; letter-spacing: .14em;
    color: var(--gold); margin-bottom: .5rem;
  }
  .plano-bloco p { font-size: 1.1rem; }
  .plano-bloco p:last-child { margin-bottom: 0; }
  .plano-bloco-chave {
    background: var(--surface-2); border-left: 3px solid var(--gold);
    border-radius: 0 var(--radius) var(--radius) 0; padding: 1rem 1.1rem;
  }
  .plano-perguntas { padding-left: 1.3em; margin: 0; font-size: 1.1rem; }
  .plano-perguntas li { margin-bottom: .5em; }

  .plano-nota {
    font-style: italic; color: var(--muted); border-top: 1px solid var(--border);
    padding-top: 1rem; font-size: 1.05rem;
  }

  .plano-check {
    position: relative; display: flex; align-items: center; gap: .8rem; cursor: pointer;
    background: var(--surface); border: 1px solid var(--gold-soft);
    border-radius: var(--radius); padding: 1rem 1.1rem; margin: 1.75rem 0 1.25rem;
    font-family: var(--font-title); font-weight: 600; font-size: 1rem; line-height: 1.4;
  }
  .plano-check input { position: absolute; opacity: 0; width: 1.6rem; height: 1.6rem; margin: 0; left: 1.1rem; cursor: pointer; }
  .plano-check-box {
    flex: 0 0 1.6rem; width: 1.6rem; height: 1.6rem; border-radius: 6px;
    border: 2px solid var(--gold); display: grid; place-items: center;
  }
  .plano-check-box svg { fill: none; stroke: var(--on-gold); stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; opacity: 0; }
  .plano-check input:checked + .plano-check-box { background: var(--gold); }
  .plano-check input:checked + .plano-check-box svg { opacity: 1; }
  .plano-check input:focus-visible + .plano-check-box { outline: 3px solid var(--gold); outline-offset: 3px; }

  .plano-notas label { display: block; font-family: var(--font-title); font-weight: 600; font-size: .95rem; margin-bottom: .4rem; }
  .plano-notas .opcional { font-weight: 400; color: var(--muted); }
  .plano-notas textarea {
    width: 100%; resize: vertical; min-height: 6rem;
    background: var(--surface); color: var(--text);
    border: 1px solid var(--border); border-radius: 10px; padding: .75rem .9rem;
    font-family: var(--font-body); font-size: 1.05rem; line-height: 1.5;
  }
  .plano-notas textarea:focus-visible { outline: 3px solid var(--gold); outline-offset: 2px; border-color: var(--gold); }

  .plano-nav {
    display: flex; justify-content: space-between; gap: 1rem;
    margin-top: 2rem; padding-top: 1.25rem; border-top: 1px solid var(--border);
  }
  .plano-nav a {
    display: inline-flex; align-items: center; gap: .35rem; min-height: 2.75rem;
    font-family: var(--font-title); font-weight: 600; font-size: 1rem; text-decoration: none;
    padding: .5rem .2rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .anel-valor, .plano-item, .plano-btn { transition: none; }
  }
</style>
